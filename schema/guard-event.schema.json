{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openguardrails.com/schema/0.6/guard-event.schema.json",
  "title": "GuardEvent",
  "description": "A unit observed at an OGR interception point. All fields are flat, top-level snake_case; objects are reserved for inherently structured data (payload, provenance, redactions).",
  "type": "object",
  "required": [
    "kind",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "ogr_version": {
      "type": "string",
      "const": "0.6"
    },
    "guard_id": {
      "type": "string",
      "minLength": 1,
      "description": "Correlation hint: stable across observation points for one logical action. Sent only by deployments that propagate a guard-context; absent, the runtime assigns one and correlates altitudes server-side."
    },
    "session_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the unit was observed. Absent = the runtime's receive time; only buffered/replayed events need it."
    },
    "observation_point": {
      "enum": [
        "conversation",
        "invocation",
        "execution"
      ],
      "description": "The altitude. Absent, the runtime defaults it from kind (llm_request/llm_response/user_input/model_output -> conversation; tool_call/tool_result/agent_spawn -> invocation; exec/network/file -> execution)."
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_type": {
      "type": "string"
    },
    "agent_workspace": {
      "type": "string"
    },
    "agent_owner": {
      "type": "string"
    },
    "agent_user": {
      "type": "string"
    },
    "sandbox_id": {
      "type": "string"
    },
    "parent_agent_id": {
      "type": "string"
    },
    "delegation_chain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attestation": {
      "enum": [
        "self_declared",
        "inferred",
        "network",
        "mtls",
        "gateway_api_key",
        "client_key"
      ]
    },
    "sensor_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable id of the reporting integration, e.g. openguardrails-ebpf."
    },
    "sensor_type": {
      "enum": [
        "in_process",
        "wrapper",
        "proxy",
        "kernel"
      ],
      "description": "How evadable the observer is, weakest first. Absent, consumers MUST treat the sensor as bypassable."
    },
    "sensor_version": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "llm_request",
        "llm_response",
        "user_input",
        "model_output",
        "tool_call",
        "tool_result",
        "exec",
        "network",
        "file",
        "agent_spawn"
      ]
    },
    "llm_protocol": {
      "enum": [
        "openai.chat",
        "openai.responses",
        "anthropic.messages",
        null
      ]
    },
    "payload": {
      "type": "object"
    },
    "content_encoding": {
      "enum": [
        "raw",
        "redacted",
        "hashed",
        "metadata_only"
      ],
      "default": "raw"
    },
    "redactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "start",
          "end"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "category": {
            "type": "string",
            "pattern": "^(safety|security|privacy|x)\\.[a-z0-9_.]+$"
          },
          "operator": {
            "enum": [
              "replace",
              "mask",
              "hash",
              "encrypt"
            ]
          },
          "ref": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "trust"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "enum": [
              "system",
              "user",
              "model",
              "tool_result",
              "web",
              "mcp",
              "file",
              "retrieved"
            ]
          },
          "trust": {
            "enum": [
              "trusted",
              "untrusted",
              "unverified"
            ]
          },
          "ref": {
            "type": "string"
          },
          "taint_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
