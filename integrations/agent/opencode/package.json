{
  "name": "@openguardrails/opencode-auto-mode",
  "version": "0.3.0",
  "description": "Auto mode for opencode: permission prompts answered by an OpenGuardrails runtime verdict instead of a human — OGR v0.8, one evaluate call per held tool call, no SDK, no core changes.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "OpenGuardrails",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --test tests/*.spec.mjs",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "auto-mode",
    "permissions",
    "approval",
    "opencode",
    "plugin",
    "ai",
    "agent",
    "security",
    "guardrails",
    "ogr",
    "openguardrails"
  ],
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openguardrails/openguardrails.git",
    "directory": "integrations/agent/opencode"
  },
  "homepage": "https://openguardrails.com",
  "publishConfig": {
    "access": "public"
  }
}
